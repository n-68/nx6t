<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>nx6t</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap');

* { margin: 0; padding: 0; box-sizing: border-box; }

html, body {
  width: 100%; height: 100%;
  overflow: hidden;
  font-family: 'Inter', Arial, sans-serif;
  background: #000;
  color: white;
}

video.bg {
  position: fixed;
  inset: 0;
  width: 100%; height: 100%;
  object-fit: cover;
  z-index: 0;
  filter: brightness(0.38);
}

#intro {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.72);
  backdrop-filter: blur(8px);
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  gap: 20px;
  z-index: 9999;
  transition: opacity 0.9s ease;
  cursor: default;
}

#intro.ready { cursor: pointer; }
#intro.hidden { opacity: 0; pointer-events: none; }

#introText {
  font-size: 36px;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-shadow: 0 0 8px #fff, 0 0 20px rgba(255,255,255,0.6), 0 0 40px rgba(255,255,255,0.3);
}

#introHint {
  font-size: 13px;
  font-weight: 500;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: rgba(255,255,255,0.45);
  opacity: 0;
  transition: opacity 0.6s ease;
}

#introHint.show {
  opacity: 1;
  animation: pulse 2s ease-in-out infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 0.45; }
  50% { opacity: 0.9; }
}

.card {
  position: absolute;
  top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  z-index: 10;
  text-align: center;
  background: rgba(0,0,0,0.48);
  border: 1px solid rgba(255,255,255,0.08);
  padding: 36px 32px 30px;
  border-radius: 20px;
  width: 320px;
  backdrop-filter: blur(14px);
  box-shadow: 0 8px 32px rgba(0,0,0,0.5), 0 0 0 1px rgba(255,255,255,0.04) inset;
  animation: fadeUp 0.7s ease 1.2s both;
}

@keyframes fadeUp {
  from { opacity: 0; transform: translate(-50%, calc(-50% + 20px)); }
  to   { opacity: 1; transform: translate(-50%, -50%); }
}

.name {
  font-size: 30px;
  font-weight: 700;
  letter-spacing: 0.04em;
  text-shadow: 0 0 6px #fff, 0 0 16px rgba(255,255,255,0.6), 0 0 32px rgba(255,255,255,0.25);
  margin-bottom: 10px;
}

.subtitle {
  font-size: 13.5px;
  color: #ccc;
  min-height: 22px;
  letter-spacing: 0.02em;
}

.cursor {
  animation: blink 0.7s step-end infinite;
  color: rgba(255,255,255,0.6);
}

@keyframes blink { 50% { opacity: 0; } }

.location {
  font-size: 12px;
  color: #999;
  margin-top: 6px;
  letter-spacing: 0.03em;
}

.views {
  margin-top: 14px;
  font-size: 14px;
}

.views-count {
  font-weight: 700;
  text-shadow: 0 0 6px rgba(255,255,255,0.8), 0 0 12px rgba(255,255,255,0.4);
}

.views-label { color: rgba(255,255,255,0.55); font-size: 13px; }

.links {
  display: flex;
  justify-content: center;
  margin-top: 18px;
}

.discord-btn {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  padding: 10px 20px;
  border-radius: 12px;
  font-size: 13.5px;
  font-weight: 600;
  text-decoration: none;
  color: white;
  background: rgba(88,101,242,0.25);
  border: 1px solid rgba(88,101,242,0.4);
  transition: background 0.2s, transform 0.15s;
}

.discord-btn:hover {
  background: rgba(88,101,242,0.45);
  transform: translateY(-1px);
}
</style>
</head>
<body>

<video class="bg" autoplay muted loop playsinline>
  <source src="bg.mp4" type="video/mp4">
</video>

<audio id="audio" loop src="audio.mp3"></audio>

<div id="intro">
  <div id="introText"></div>
  <div id="introHint">click to enter</div>
</div>

<div class="card">
  <div class="name">nx6t</div>
  <div class="subtitle">
    <span id="typewriter"></span><span class="cursor">|</span>
  </div>
  <div class="location">📍 Bahrain</div>
  <div class="views">
    <span class="views-count">12,108</span>
    <span class="views-label"> views</span>
  </div>
  <div class="links">
    <a class="discord-btn" href="https://discord.com/users/1244657402972868622" target="_blank">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
        <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057.102 18.079.114 18.1.132 18.114a19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03z"/>
      </svg>
      Discord
    </a>
  </div>
</div>

<script>
// Intro typer
const introName = 'nx6t';
let iChar = 0;
const introEl  = document.getElementById('introText');
const hintEl   = document.getElementById('introHint');
const introDiv = document.getElementById('intro');

function typeIntro() {
  if (iChar < introName.length) {
    introEl.textContent += introName[iChar++];
    setTimeout(typeIntro, 150);
  } else {
    setTimeout(function() {
      introDiv.classList.add('ready');
      hintEl.classList.add('show');
    }, 400);
  }
}
typeIntro();

introDiv.addEventListener('click', function() {
  if (!introDiv.classList.contains('ready')) return;
  introDiv.classList.add('hidden');
  var audio = document.getElementById('audio');
  audio.volume = 0.35;
  audio.play();
});

// Looping typewriter
var subtitle = 'Miyano shiho';
var idx = 0, deleting = false;
var twEl = document.getElementById('typewriter');

function loopType() {
  if (!deleting) {
    twEl.textContent = subtitle.substring(0, idx++);
    if (idx > subtitle.length) { deleting = true; setTimeout(loopType, 1200); return; }
  } else {
    twEl.textContent = subtitle.substring(0, idx--);
    if (idx === 0) deleting = false;
  }
  setTimeout(loopType, deleting ? 50 : 100);
}
loopType();
</script>

</body>
</html>
